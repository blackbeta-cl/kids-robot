# Copia este archivo a server/.env (nunca se sube a git: está en .gitignore) y rellénalo.
# Formato: una línea CLAVE=valor. Los comentarios van en líneas propias (no al final de la línea del valor).
# Con systemd también se carga con EnvironmentFile (ver deploy/robot-puente.service).
# Permisos recomendados en el servidor:  chmod 600 .env

# ---------- Obligatorias ----------
# Token que el robot manda en la cabecera X-Token. Genera uno largo:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# El mismo valor va en el firmware (comando "token" por cable, o TOKEN_ROBOT en wifi_config.h).
ROBOT_TOKEN=

# Modelo de lenguaje: cualquier API compatible con OpenAI (POST .../chat/completions).
# LLM_API_KEY, LLM_URL y LLM_MODEL van JUNTOS: sin URL y modelo el servidor no envía la clave a ningún sitio.
# IMPORTANTE: lo que dice el niño (transcrito a texto) se envía a ese proveedor. Lee la sección
# "Privacidad y datos de menores" del README antes de elegirlo.
LLM_API_KEY=
LLM_URL=
LLM_MODEL=

# ---------- Personalización ----------
# Cómo se llama el robot en su personalidad por defecto.
ROBOT_NOMBRE=Robi
# Clave bajo la que se guardan persona y recuerdos (no la cambies después de usar el robot).
ROBOT_ID=robot
# Zona horaria de tu casa (de ella dependen alarmas y recordatorios): America/Mexico_City, Europe/Madrid, America/Santiago...
ROBOT_TZ=UTC
FAMILIA_ID=1

# ---------- Voz ----------
# Whisper: tiny | base | small | medium (más grande = entiende mejor y tarda más; con 1 vCPU usa base).
WHISPER_MODELO=base
# local = Whisper en tu servidor (el audio no sale). groq = envía el AUDIO a Groq (ver README).
STT_PROVEEDOR=local
# Solo si STT_PROVEEDOR=groq.
GROQ_API_KEY=
# Voz de edge-tts: el TEXTO de las respuestas se envía a Microsoft (ver README).
VOZ_TTS=es-ES-ElviraNeural
VOZ_TONO=+35Hz
VOZ_RITMO=+6%
# 0 = voz normal, 1 = muy robótica.
VOZ_ROBOT=0.45
# Caché de voz en memoria (no en disco): las frases que se repiten no se vuelven a sintetizar.
# CACHE_VOZ_MAX_ENTRADAS=0 la apaga. CACHE_VOZ_PRECALENTAR=0 no sintetiza las frases fijas al arrancar.
CACHE_VOZ_MAX_ENTRADAS=200
CACHE_VOZ_MAX_MB=40
CACHE_VOZ_PRECALENTAR=1

# ---------- Red ----------
# Detrás de Caddy/nginx déjalo en 127.0.0.1. 0.0.0.0 solo en una red local de confianza.
HOST=127.0.0.1
PUERTO=8081
# Donde están app.bin y version.json para la OTA (por defecto ./firmware):
# FIRMWARE_DIR=/opt/kids-robot/firmware
# Base de datos y datos de la familia (por defecto ./datos):
# ROBOT_DATOS=/opt/kids-robot/datos

# ---------- Opcionales ----------
# 0 apaga el panel web de padres:
# PANEL_PADRES=0
# 0 apaga los recuerdos (hechos y rasgos):
# MEMORIA_ACTIVA=0
# 0 deja de proponer hechos automáticamente:
# EXTRAER_AUTOMATICO=0
# Solo si conectas la placa por USB a este equipo (p. ej. COM7, /dev/ttyACM0):
# SERIAL_PORT=
